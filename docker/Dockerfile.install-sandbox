# RomM remote-install sandbox image (optional, separate from the main image).
#
# The main RomM image is Alpine/musl, where Wine/Proton and the X/VNC stack are
# unreliable. Server-side installs therefore run in this dedicated Debian-based
# image, which carries the untrusted-installer runtime:
#   - bubblewrap: unprivileged sandbox that confines the installer process
#   - Xvfb + x11vnc + websockify/noVNC: headless display streamed to the browser
#   - icewm: minimal window manager for that Xvfb display - without one,
#     installer windows (InstallShield/Inno Setup wizards especially) can get
#     stuck unmapped or at their placeholder 1x1 geometry, since they rely on
#     a WM to actually negotiate their real size
#   - picom: compositing manager - modern Inno Setup/InstallShield wizards
#     commonly draw their wizard page as a layered (WS_EX_LAYERED) window for
#     rounded corners/gradients; layered windows render as fully transparent
#     (indistinguishable from a blank/black client area) without something
#     actually compositing them. xcompmgr (the minimal reference compositor)
#     was tried first and wasn't enough - the window kept painting opaque
#     black instead of its actual content; picom's more complete backend is
#     the standard choice for exactly this class of minimal-WM Wine setup.
#   - GE-Proton (bundled below): runs Windows installers; plain Wine (also
#     installed, as Proton's own base) is the fallback if INSTALL_PROTON_PATH
#     is ever cleared
#   - tesseract-ocr + xdotool: auto-clicker to drive "Next" dialogs (Phase 4)
#
# Build:  docker build -f docker/Dockerfile.install-sandbox -t romm-install-sandbox .
# This image is meant to run the RQ worker that executes install jobs, not the
# web app. Wire it via a separate compose service that shares Redis, the DB, and
# the INSTALL_CACHE_PATH volume with the main app.

ARG DEBIAN_VERSION=bookworm-slim
ARG PYTHON_VERSION=3.13

FROM python:${PYTHON_VERSION}-slim-bookworm AS sandbox-base

ENV DEBIAN_FRONTEND=noninteractive

# Wine needs the i386 arch for 32-bit Windows installers.
# libvulkan1/mesa-vulkan-drivers: GE-Proton's own launcher script CDLLs
# libvulkan.so.1 at import time regardless of whether an install actually
# needs 3D - without it "proton" itself fails to even start. The Mesa
# driver gives it a real (software) ICD to enumerate rather than none.
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    bubblewrap \
    xvfb \
    x11vnc \
    websockify \
    novnc \
    xdotool \
    icewm \
    picom \
    tesseract-ocr \
    wine \
    wine32:i386 \
    ca-certificates \
    curl \
    git \
    build-essential \
    libpq-dev \
    libmariadb-dev \
    libmagic1 \
    libvulkan1 \
    mesa-vulkan-drivers \
    p7zip-full \
    libarchive-tools \
    && rm -rf /var/lib/apt/lists/*

# backend/utils/archives.py hardcodes /usr/bin/7zz (the official 7-Zip CLI,
# apt package "7zip" - not available before Debian trixie); this bookworm
# base only has p7zip-full's /usr/bin/7z, which is argument-compatible for
# the operations archives.py actually uses (listing, single-member extract).
# libarchive-tools already provides bsdtar (RAR support), matching the main
# image's archive toolset.
RUN ln -s /usr/bin/7z /usr/bin/7zz

# Xvfb (run as the unprivileged romm-install user, never root) refuses to
# start unless /tmp/.X11-unix is owned by root with the sticky bit set - the
# xvfb/x11-common package's own postinst is supposed to guarantee this, but
# has been observed not to on a rebuild. Belt and suspenders: create it here
# explicitly, as root, before the USER switch below.
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# noVNC ships its client under /usr/share/novnc on Debian; the runner expects it
# at NOVNC_WEB_ROOT (/usr/share/novnc). Symlink the default client entry point.
RUN if [ -f /usr/share/novnc/vnc_lite.html ] && [ ! -f /usr/share/novnc/vnc.html ]; then \
    ln -s /usr/share/novnc/vnc_lite.html /usr/share/novnc/vnc.html; \
    fi

# IceWM preference overrides - see the file itself for why FocusOnMapTransient
# needs forcing on. Loaded via icewm's own --config flag (handler/install/
# vnc.py), not $HOME/.icewm/preferences, so it applies regardless of $HOME.
COPY ./docker/icewm-preferences /etc/icewm-preferences

# GE-Proton (default) + Proton-CachyOS (selectable), side by side: used
# instead of plain Wine to run the actual Windows installer - broader
# DXVK/vkd3d/media-codec coverage, which some installers (and the games they
# install) depend on. Two builds rather than one so an installer that
# doesn't get along with one still has the other to try (see
# handler/install/proton_builds.py's registry and the "Proton version"
# picker it feeds).
#
# GE-Proton is pinned to the 10.x line (bump the ARG deliberately, not
# "latest"): starting with GE-Proton11-1, GloriousEggroll moved the build
# environment to one that links against glibc 2.38+, which this image's
# Debian bookworm base (glibc 2.36) can't satisfy - "wine: could not load
# ntdll.so: ... version `GLIBC_2.38' not found". GE-Proton10-34 only needs
# glibc 2.25; bumping past it needs either a newer base image or confirming
# the target release's ntdll.so glibc requirement first.
#
# Proton-CachyOS is resolved to whatever its GitHub releases API currently
# reports as "latest" at image build time (not pinned - bump by rebuilding
# the image), picking the plain x86_64 asset over the _v3 one for broader
# CPU compatibility. (Tried once already as an alternative to rule out a
# Proton-build-specific cause for an installer-window-stays-blank rendering
# bug - it reproduced identically, pointing at this sandbox's X11/compositor
# setup instead, but confirmed it runs fine on this glibc 2.36 base. See
# xcompmgr/picom below.)
#
# Placed before the COPY steps below so these large layers stay cached
# across ordinary backend-source rebuilds.
ARG GE_PROTON_VERSION=GE-Proton10-34
RUN curl -fsSL \
    "https://github.com/GloriousEggroll/proton-ge-custom/releases/download/${GE_PROTON_VERSION}/${GE_PROTON_VERSION}.tar.gz" \
    -o /tmp/proton-ge.tar.gz \
    && mkdir -p /opt/proton-ge \
    && tar -xzf /tmp/proton-ge.tar.gz -C /opt/proton-ge --strip-components=1 \
    && rm /tmp/proton-ge.tar.gz \
    && chmod -R a+rX /opt/proton-ge
ENV INSTALL_PROTON_PATH=/opt/proton-ge/proton

RUN CACHYOS_ASSET_URL=$(curl -fsSL https://api.github.com/repos/CachyOS/proton-cachyos/releases/latest \
        | grep -oP '"browser_download_url":\s*"\K[^"]*-x86_64\.tar\.xz(?=")') \
    && curl -fsSL "$CACHYOS_ASSET_URL" -o /tmp/proton-cachyos.tar.xz \
    && mkdir -p /opt/proton-cachyos \
    && tar -xJf /tmp/proton-cachyos.tar.xz -C /opt/proton-cachyos --strip-components=1 \
    && rm /tmp/proton-cachyos.tar.xz \
    && chmod -R a+rX /opt/proton-cachyos
ENV INSTALL_PROTON_CACHYOS_PATH=/opt/proton-cachyos/proton

COPY --from=ghcr.io/astral-sh/uv:0.11.2 /uv /usr/local/bin/uv

WORKDIR /src
COPY ./pyproject.toml ./uv.lock /src/
RUN uv sync --frozen --no-cache --all-extras

COPY ./backend /src/backend
COPY ./docker/init_scripts/install-sandbox-entrypoint.sh /usr/local/bin/install-sandbox-entrypoint.sh
RUN chmod +x /usr/local/bin/install-sandbox-entrypoint.sh
WORKDIR /src/backend

# Run as a non-root user; bubblewrap needs unprivileged user namespaces enabled
# on the host kernel (kernel.unprivileged_userns_clone=1).
RUN useradd --create-home --uid 10001 romm-install
USER romm-install

# The worker only consumes the dedicated "install" queue (see QueuePrio in
# handler/redis_handler.py), never "high"/"default"/"low": those are handled
# by the main app's own Alpine-based workers, which don't carry this image's
# Wine/Xvfb/bubblewrap stack.
ENV INSTALL_SANDBOX_ENABLED=true

# See install-sandbox-entrypoint.sh: warms up Wine once, then starts the RQ
# worker with --no-sync (the venv built at image build time is already
# complete and frozen; without it, `uv run` re-resolves/syncs against the
# lockfile on every container start, which needs scratch space under the
# container's writable layer for no benefit here and can leave a broken venv
# behind if it's interrupted, e.g. by disk pressure).
CMD ["install-sandbox-entrypoint.sh"]
